[
  {
    "name": "list_environments",
    "title": "1Password: List Environments",
    "description": "List all 1Password Environments in the account with their IDs and names. Read-only; never returns secret values.",
    "routePath": "1password-enconvo/list_environments",
    "parameters": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "description": "Optional 1Password account ID override"
        }
      }
    }
  },
  {
    "name": "create_environment",
    "title": "1Password: Create Environment",
    "description": "Create a new 1Password Environment by name in the account.",
    "routePath": "1password-enconvo/create_environment",
    "parameters": {
      "type": "object",
      "properties": {
        "environmentName": {
          "type": "string",
          "description": "Name for the new Environment"
        },
        "account_id": {
          "type": "string",
          "description": "Optional 1Password account ID override"
        }
      },
      "required": [
        "environmentName"
      ]
    }
  },
  {
    "name": "rename_environment",
    "title": "1Password: Rename Environment",
    "description": "Rename a 1Password Environment, given its name or ID.",
    "routePath": "1password-enconvo/rename_environment",
    "parameters": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "description": "Environment name or ID"
        },
        "newName": {
          "type": "string",
          "description": "The new name"
        },
        "account_id": {
          "type": "string",
          "description": "Optional 1Password account ID override"
        }
      },
      "required": [
        "environment",
        "newName"
      ]
    }
  },
  {
    "name": "list_variables",
    "title": "1Password: List Variable Names",
    "description": "List the variable NAMES stored in a 1Password Environment. Never returns values — by design.",
    "routePath": "1password-enconvo/list_variables",
    "parameters": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "description": "Environment name or ID"
        },
        "account_id": {
          "type": "string",
          "description": "Optional 1Password account ID override"
        }
      },
      "required": [
        "environment"
      ]
    }
  },
  {
    "name": "append_variables",
    "title": "1Password: Add Variables",
    "description": "Add or update variables in a 1Password Environment. Values flow into the vault only and are never returned to the caller.",
    "routePath": "1password-enconvo/append_variables",
    "parameters": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "description": "Environment name or ID"
        },
        "variables": {
          "type": "array",
          "description": "Variables to add or update",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Variable name, e.g. ACME_API_KEY"
              },
              "value": {
                "type": "string",
                "description": "Variable value (stored in the vault, write-only)"
              },
              "concealed": {
                "type": "boolean",
                "description": "Conceal the value when displayed (default true)"
              }
            },
            "required": [
              "name",
              "value"
            ]
          }
        },
        "account_id": {
          "type": "string",
          "description": "Optional 1Password account ID override"
        }
      },
      "required": [
        "environment",
        "variables"
      ]
    }
  },
  {
    "name": "create_local_env_file",
    "title": "1Password: Mount .env",
    "description": "Create a locally mounted .env file for a 1Password Environment. Secret values resolve on demand inside processes and are never written to disk or returned to the agent. Never read this file into a chat.",
    "routePath": "1password-enconvo/create_local_env_file",
    "parameters": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string",
          "description": "Environment name or ID"
        },
        "mountPath": {
          "type": "string",
          "description": "Absolute path where the .env file should be mounted"
        },
        "account_id": {
          "type": "string",
          "description": "Optional 1Password account ID override"
        }
      },
      "required": [
        "environment",
        "mountPath"
      ]
    }
  },
  {
    "name": "list_local_env_files",
    "title": "1Password: List Mounts",
